# Copy this file to .env. Do not add a trailing slash to ROOT_ADDRESS.
# For local network access, replace the domain with this server's local IP,
# for example: http://192.168.1.8:8000
# Generate the secrets by running:
# sed -i "s/CHANGE_ME_SECRET_KEY/$(openssl rand -hex 32)/; s/CHANGE_ME_POSTGRES_PASSWORD/$(openssl rand -hex 24)/" .env
SECRET_KEY=CHANGE_ME_SECRET_KEY
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
ROOT_ADDRESS=https://classquiz.de
